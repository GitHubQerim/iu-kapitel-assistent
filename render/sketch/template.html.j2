<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Lernblatt · {{ chapter.title }}</title>
<style>
{{ font_face_css | safe }}
{{ sketch_css | safe }}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="wob" x="-5%" y="-5%" width="110%" height="110%">
    <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>
<button class="print-btn" onclick="window.print()">Drucken</button>

{% import "_blocks.html.j2" as blocks_macro %}

{% for page in pages %}
<section class="page{% if loop.last and last_page_sparse %} compact{% endif %}">
  <div class="head">
    <div>
      <div class="kicker">{{ module }} · Lektion {{ chapter.number }} ·
        {% if loop.first %}Skript S. {{ chapter.pages }}{% else %}Teil {{ loop.index }}{% endif %}</div>
      <div class="title">{{ chapter.title|upper }}{% if not loop.first %} (FORTS.){% endif %}</div>
    </div>
    {% if loop.first %}
    <div class="sticky"><b>Lernziele</b> — nach der Lektion weiß ich …<br>
      {% set circled_digits = "①②③④⑤⑥⑦⑧⑨⑩" %}
      {% for goal in learning_goals %}{{ circled_digits[loop.index0] if loop.index0 < 10 else loop.index ~ "." }} {{ goal }}{% if not loop.last %}&nbsp;&nbsp;{% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="grid">
    {% for column in page %}
    <div class="col">
      {% for block in column %}{{ blocks_macro.render_block(block) }}{% endfor %}
    </div>
    {% endfor %}
  </div>

  {% if loop.last and (merkliste or glossar) %}
  {{ blocks_macro.render_footer(merkliste, glossar) }}
  {% endif %}

  <div class="foot"><span>Lernblatt · Lektion {{ chapter.number }} · Seite {{ loop.index }}/{{ pages|length }}</span><span>Seitenangaben = IU-Skript</span></div>
</section>
{% endfor %}
</body>
</html>
